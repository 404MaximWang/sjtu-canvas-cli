<?xml version="1.0" encoding="UTF-8"?>
<!-- sjtu daemon — launchd agent definition.
     Embedded into the sjtu binary; `sjtu daemon install` renders it with the
     resolved absolute path of the running binary and bootstraps the agent. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>cn.edu.sjtu.sjtud</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{BINARY_PATH}}</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart=on-failure equivalent: relaunch only when the exit was abnormal. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
