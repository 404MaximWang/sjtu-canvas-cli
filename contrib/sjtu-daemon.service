# sjtu daemon — systemd user service template.
# Install:  systemctl --user link <this file> && systemctl --user enable --now sjtu-daemon
# Adjust ExecStart to the installed sjtu binary path.
[Unit]
Description=sjtu daemon (SJTU online services local command server)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/sjtu daemon
Restart=on-failure
# The daemon itself waits at most 5 s for in-flight requests on SIGTERM;
# allow 15 s before SIGKILL.
TimeoutStopSec=15

[Install]
WantedBy=default.target
